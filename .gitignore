.venv/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
.tools/
.github-publish/
*_check/
*-check/
qt-test-data/
qt-smoke/

# Everything a build, a release or a test run produces lives under .build/.
# See docs/STRUCTURE.md for what each subfolder holds.
.build/
.build-temp/
.build-cache/
releases/
.runtime-bundle/
.bundle-downloads/

# Launcher runtime state stays at the root: published offline packages and
# release fixtures expect it there.
.launcher-state/

# Local account data, browser profiles and credentials never leave the machine.
data/
*-profiles/
# The publisher's sender configuration carries an SMTP credential; only the
# empty example is tracked.
email_sender.json
.env
.env.*
*.pem
*.key
*.sqlite*
*.zip
# Stray run output. Logs and smoke/check reports are never source, at any
# depth; PNGs stay root-only because assets/ legitimately holds icons.
*.log
*smoke*.json
*check*.json
/*.png
tmp*/
*.tmp
# A pip killed mid-install leaves its scratch directories in the working
# directory instead of TEMP, so ignore them at any depth.
pip-*/
pip-*.tmp/
temp-*/
.superpowers/
